{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "2026-akabanedai-fes",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "routes": [
    {
      "pattern": "akabanedai-fes.com/10",
      "zone_name": "akabanedai-fes.com",
    },
    {
      "pattern": "akabanedai-fes.com/10/*",
      "zone_name": "akabanedai-fes.com",
    },
  ],
  "workers_dev": false,
  "secrets": {
    "required": ["AKABASE_API_KEY"],
  },
}
